# Copy to local_paths.env and adapt; unset entries use the defaults in src/paths.py.
# Environment variables with the same names take precedence over this file.

# Datasets (default: data/ in the repository)
# PRHCL_DATA_DIR=/path/to/data
# PRHCL_COCO_DIR=/path/to/coco                          # default: $PRHCL_DATA_DIR/coco
# PRHCL_CC3M_RECAPTIONED_DIR=/path/to/cc3m_recaptioned  # default: $PRHCL_DATA_DIR/cc3m_recaptioned
# PRHCL_DOCCI_DIR=/path/to/docci                        # default: $PRHCL_DATA_DIR/docci
# PRHCL_DOCCI_WITH_SUMMARIES_DIR=/path/to/docci_with_summaries

# Results (default: results/ in the repository)
# PRHCL_RESULTS_DIR=/path/to/results
# PRHCL_FEATURES_DIR=/path/to/features                  # default: $PRHCL_RESULTS_DIR/features
# PRHCL_ALIGNMENT_DIR=/path/to/alignment                # default: $PRHCL_RESULTS_DIR/alignment
# PRHCL_PLOTS_DIR=/path/to/plots                        # default: $PRHCL_RESULTS_DIR/plots
# PRHCL_BENCHMARK_DIR=/path/to/benchmark_results        # default: benchmark_results/ in the repository
